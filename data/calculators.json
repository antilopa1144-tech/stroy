[
  {
    "id": "paint_wall",
    "title": "Краска для стен",
    "category": "Краски",
    "fields": [
      {
        "key": "length",
        "label": "Длина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 4
      },
      {
        "key": "width",
        "label": "Ширина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 3
      },
      {
        "key": "height",
        "label": "Высота комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 2.5
      },
      {
        "key": "doors",
        "label": "Площадь дверей (м²)",
        "type": "number",
        "unit": "m²",
        "default": 1.9
      },
      {
        "key": "windows",
        "label": "Площадь окон (м²)",
        "type": "number",
        "unit": "m²",
        "default": 2.5
      },
      {
        "key": "coats",
        "label": "Количество слоёв",
        "type": "integer",
        "default": 2
      },
      {
        "key": "coverage",
        "label": "Укрывистость (м²/л)",
        "type": "number",
        "default": 10
      },
      {
        "key": "waste",
        "label": "Запас (%)",
        "type": "percent",
        "default": 10
      }
    ],
    "computed": {
      "area": "((length*height*2) + (width*height*2)) - doors - windows",
      "litres": "Math.ceil((area * coats / coverage) * (1 + waste/100))"
    },
    "outputs": [
      {
        "key": "area",
        "label": "Площадь окраски (м²)",
        "format": "m²"
      },
      {
        "key": "litres",
        "label": "Требуемое количество литров",
        "format": "л"
      }
    ]
  },
  {
    "id": "laminate_floor",
    "title": "Ламинат",
    "category": "Полы",
    "fields": [
      {
        "key": "length",
        "label": "Длина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 4
      },
      {
        "key": "width",
        "label": "Ширина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 3
      },
      {
        "key": "plank_length",
        "label": "Длина планки (см)",
        "type": "number",
        "unit": "cm",
        "default": 120
      },
      {
        "key": "plank_width",
        "label": "Ширина планки (см)",
        "type": "number",
        "unit": "cm",
        "default": 20
      },
      {
        "key": "pack_area",
        "label": "Площадь пачки (м²)",
        "type": "number",
        "unit": "m²",
        "default": 2.0
      },
      {
        "key": "waste",
        "label": "Запас (%)",
        "type": "percent",
        "default": 5
      }
    ],
    "computed": {
      "room_area": "length * width",
      "total_area": "room_area * (1 + waste/100)",
      "packs": "Math.ceil(total_area / pack_area)"
    },
    "outputs": [
      {
        "key": "room_area",
        "label": "Площадь комнаты (м²)",
        "format": "m²"
      },
      {
        "key": "packs",
        "label": "Количество пачек",
        "format": "шт"
      }
    ]
  },
  {
    "id": "tile_floor",
    "title": "Плитка",
    "category": "Полы",
    "fields": [
      {
        "key": "length",
        "label": "Длина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 4
      },
      {
        "key": "width",
        "label": "Ширина комнаты (м)",
        "type": "number",
        "unit": "m",
        "default": 3
      },
      {
        "key": "tile_length",
        "label": "Длина плитки (см)",
        "type": "number",
        "unit": "cm",
        "default": 30
      },
      {
        "key": "tile_width",
        "label": "Ширина плитки (см)",
        "type": "number",
        "unit": "cm",
        "default": 30
      },
      {
        "key": "tiles_per_box",
        "label": "Плиток в коробке",
        "type": "integer",
        "default": 10
      },
      {
        "key": "waste",
        "label": "Запас (%)",
        "type": "percent",
        "default": 7
      }
    ],
    "computed": {
      "room_area": "length * width",
      "tile_area": "(tile_length/100) * (tile_width/100)",
      "tiles_needed": "Math.ceil((room_area * (1 + waste/100)) / tile_area)",
      "boxes": "Math.ceil(tiles_needed / tiles_per_box)"
    },
    "outputs": [
      {
        "key": "tiles_needed",
        "label": "Требуемое количество плиток",
        "format": "шт"
      },
      {
        "key": "boxes",
        "label": "Коробок",
        "format": "шт"
      }
    ]
  },
  {
    "id": "plaster",
    "title": "Штукатурка",
    "category": "Смеси",
    "fields": [
      {
        "key": "area",
        "label": "Площадь (м²)",
        "type": "number",
        "unit": "m²",
        "default": 20
      },
      {
        "key": "thickness",
        "label": "Толщина слоя (мм)",
        "type": "number",
        "unit": "mm",
        "default": 10
      },
      {
        "key": "consumption",
        "label": "Расход (кг/м²/мм)",
        "type": "number",
        "default": 1.0
      },
      {
        "key": "bag_weight",
        "label": "Вес мешка (кг)",
        "type": "number",
        "unit": "kg",
        "default": 25
      },
      {
        "key": "waste",
        "label": "Запас (%)",
        "type": "percent",
        "default": 10
      }
    ],
    "computed": {
      "kg_needed": "area * thickness * consumption * (1 + waste/100)",
      "bags": "Math.ceil(kg_needed / bag_weight)"
    },
    "outputs": [
      {
        "key": "kg_needed",
        "label": "Необходимое количество смеси (кг)",
        "format": "кг"
      },
      {
        "key": "bags",
        "label": "Количество мешков",
        "format": "шт"
      }
    ]
  },
